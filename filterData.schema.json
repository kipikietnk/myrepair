{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilog.local/schema/filterData.schema.json",
  "title": "Filter Data",
  "description": "Recursive filter tree for HomePage dropdown filters.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/filterNode"
  },
  "$defs": {
    "filterNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tags"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupData": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filterNode"
          }
        }
      }
    }
  }
}
